{
  "name": "hagervisit-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "HagerVisit - Ethiopian Travel & Tourism Ecosystem",
  "scripts": {
    "dev": "npm --prefix apps/mobile run dev",
    "dev:mobile": "npm --prefix apps/mobile run dev",
    "dev:mobile:web": "npm --prefix apps/mobile run dev:web",
    "dev:mobile:ios": "npm --prefix apps/mobile run dev:ios",
    "dev:mobile:android": "npm --prefix apps/mobile run dev:android",
    "mobile": "npm --prefix apps/mobile run dev",
    "mobile:ios": "npm --prefix apps/mobile run dev:ios",
    "mobile:android": "npm --prefix apps/mobile run dev:android",
    "mobile:web": "npm --prefix apps/mobile run dev:web"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
